<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- MCP 引擎产出官方 SDK 的协议结果对象；Streamable HTTP 宿主（McpWebHost）也在此层，
         App 与测试共用同一套传输实现 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <!-- 文档模板（模板中心内置库，2026-11-13）：产品真值同源——原型经 design/scripts/generate-templates.cjs
         从本目录生成演示数据，桌面端经 TemplateLibrary.LoadBuiltins 读同一批内嵌资源 -->
    <EmbeddedResource Include="Templates\**\*.md" />
  </ItemGroup>
</Project>
