<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Vox</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Arc 依赖链要求：输入框/选择器依赖区域性数据格式化，不可启用 InvariantGlobalization -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- MCP 官方 SDK 的 Streamable HTTP 传输跑在进程内 Kestrel 上（宿主在 Vox.Core/McpWebHost），
         ASP.NET Core 框架经 Vox.Core 的 FrameworkReference 传递 -->
    <PackageReference Include="Avalonia.Themes.Simple" />

    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="TextMateSharp.Grammars" />
    <PackageReference Include="TKCode.Arc" />
    <PackageReference Include="TKCode.Arc.Fonts" />
    <PackageReference Include="TKCode.Arc.Icons.Lucide" />
    <PackageReference Include="TKCode.StreamMark.Avalonia" />
    <PackageReference Include="TKCode.StreamMark.Highlighting.TextMate" />
    <PackageReference Include="TKCode.StreamMark.Core" />
    <PackageReference Include="CodeWF.Toolkit.Lang" />
    <PackageReference Include="CodeWF.Avalonia.Lang" />
    <PackageReference Include="CodeWF.Avalonia.DataGrid" />
    <PackageReference Include="CodeWF.Avalonia.Markdown" />
    <PackageReference Include="CodeWF.Avalonia.MindView" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vox.Core\Vox.Core.csproj" />
    <ProjectReference Include="..\Vox.Git\Vox.Git.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 编译期从语言 JSON 生成强类型 ResourceKeys（CodeWF.Avalonia.Lang.Generator） -->
    <PackageReference Include="CodeWF.Avalonia.Lang.Generator">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <AdditionalFiles Include="I18n\*.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- 应用语言 JSON 随包拷贝到输出 I18n/，JsonLangPlugin 按目录扫描加载 -->
    <Content Include="I18n\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 文件类型图标（material-icon-theme 子集）：磁盘 Content 而非 Ava 资源——FileIconCatalog 按
         AppContext.BaseDirectory/file-icons 从文件系统按需读取并缓存解码位图，AOT 发布原样携带。 -->
    <Content Include="Assets\FileIcons\**\*" Link="file-icons\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
