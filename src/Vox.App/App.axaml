<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markdownThemes="https://codewf.com"
             xmlns:codewf="https://codewf.com"
             x:Class="Vox.App.App">
  <!-- AvaloniaEdit Simple 主题要求宿主提供三个字体令牌（Fluent 过去自带） -->
  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="FontFamilyNormal">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans SC</FontFamily>
      <x:Double x:Key="FontSizeNormal">14</x:Double>
      <FontWeight x:Key="FontWeightNormal">Normal</FontWeight>
      <!-- DataGrid 排序箭头：Semi 主题里这两个键指向未随包的 SemiIcon 资源，这里直接给出几何 -->
      <StreamGeometry x:Key="DataGridColumnHeaderAscendingGlyph">M0,5 L5,0 L10,5 Z</StreamGeometry>
      <StreamGeometry x:Key="DataGridColumnHeaderDescendingGlyph">M0,0 L10,0 L5,5 Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- 注意：不要在此全局引入 Avalonia.Themes.Simple——Simple 的 Button/ListBox/ListBoxItem 等隐式样式
         会压过 Arc 的控件主题（导航变默认按钮、标题栏双标题、折叠钮错位，2026-11-10 实测复现）。
         Arc 基础主题检测到已有主题的类型即跳过注册，全局 Simple 先注册会让 Arc 全量跳过。
         大纲/列表行 DataTemplate 若出现不实例化，用局部作用域（控件级 Styles/显式 ControlTheme）解决，
         不再回退全局 Simple。 -->
    <StyleInclude Source="/Themes/VoxStyles.axaml"/>
    <!-- AvaloniaEdit 完整控件主题（编辑器模板）；Base 资源由 MarkdownFullThemes 内引 -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml"/>
    <!-- CodeWF.Avalonia.Markdown 完整包样式（编辑器外观 + 图片能力控件 + Markdown 模板），
         资源独立于宿主应用主题（Arc），只作用于 Markdown/编辑器控件。 -->
    <markdownThemes:MarkdownFullThemes TypographyTheme="Simple"/>
    <!-- CodeWF.Avalonia.MindView 导图控件样式（MarkdownMindMapView 模板与点阵）。 -->
    <markdownThemes:MindViewThemes/>
    <!-- DataGrid 的 Semi 主题入口（只注入 DataGrid 相关模板与调色板，不影响 Arc 其它控件）。 -->
    <codewf:DataGridSemiTheme/>
  </Application.Styles>
</Application>
