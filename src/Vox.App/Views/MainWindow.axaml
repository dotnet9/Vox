<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Vox.App.Views.MainWindow"
        Title="Vox" Width="1280" Height="800" MinWidth="960" MinHeight="620">
  <Grid ColumnDefinitions="212,*">
    <Border Grid.Column="0" x:Name="NavHost" />
    <ContentControl Grid.Column="1" x:Name="ContentHost" HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
  </Grid>
</Window>
