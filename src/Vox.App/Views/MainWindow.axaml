<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Vox.App.Views.MainWindow"
        Title="Vox · 维声" Width="1280" Height="800">
  <Grid ColumnDefinitions="196,*">
    <ListBox Grid.Column="0" x:Name="NavList" SelectionMode="Single">
      <ListBoxItem>写作</ListBoxItem>
      <ListBoxItem>文章库</ListBoxItem>
      <ListBoxItem>图片库</ListBoxItem>
      <ListBoxItem>体检</ListBoxItem>
      <ListBoxItem>同步</ListBoxItem>
      <ListBoxItem>站点数据</ListBoxItem>
      <ListBoxItem>设置</ListBoxItem>
    </ListBox>
    <TextBlock Grid.Column="1" x:Name="ContentHost" Margin="24"
               VerticalAlignment="Top" FontSize="20" Text="写作" />
  </Grid>
</Window>
