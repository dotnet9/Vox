<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Vox.App.Controls"
        xmlns:icons="clr-namespace:TKCode.Arc.Icons.Lucide;assembly=TKCode.Arc.Icons.Lucide"
        x:Class="Vox.App.Views.MainWindow"
        Title="Vox · 维声"
        Width="1280" Height="830" MinWidth="1080" MinHeight="660"
        FontFamily="{DynamicResource VoxFontUi}" FontSize="13"
        Foreground="{DynamicResource VoxFg}"
        Background="{DynamicResource VoxBg}">

  <Grid RowDefinitions="Auto,*">
    <!-- 标题栏：白底 · logo 名称 文件 文件名行 · 搜索/外观/语言 · 窗口钮 -->
    <Border x:Name="Topbar" Grid.Row="0" Height="42" Background="{DynamicResource VoxSurface}"
            BorderBrush="{DynamicResource VoxLine}" BorderThickness="0,0,0,1"
            Padding="10,0,8,0" ZIndex="10">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
        <Image Grid.Column="0" Source="/Assets/app.ico" Width="18" Height="18"
               Margin="4,0,4,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="Vox · 维声" FontWeight="SemiBold" FontSize="12.5"
                   VerticalAlignment="Center" Margin="0,0,2,0"/>
        <Panel Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center">
          <Button x:Name="BtnFileMenu" Classes="tb-txt" Content="文件">
            <Button.Flyout>
              <Flyout Placement="Bottom" ShowMode="Standard">
                <Border Classes="mnu">
                  <StackPanel>
                    <Button x:Name="MiNew" Classes="mnuitem" Content="新建文章"/>
                    <Button x:Name="MiMeta" Classes="mnuitem" Content="文章元数据…"/>
                    <Button x:Name="MiImg" Classes="mnuitem" Content="图片入库…"/>
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
        </Panel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="6,0,0,0" VerticalAlignment="Center">
          <Ellipse x:Name="FileDot" Width="7" Height="7" Fill="{DynamicResource VoxWarn}" IsVisible="False"/>
          <TextBlock x:Name="FileNameText" Classes="mono" FontSize="10.5" IsVisible="False"
                     Foreground="{DynamicResource VoxMuted}"/>
          <StackPanel x:Name="FileBadges" Orientation="Horizontal" Spacing="4" IsVisible="False"/>
        </StackPanel>
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,6,0">
          <Button x:Name="BtnTbSearch" Classes="tb-ico" ToolTip.Tip="搜索（Ctrl K）">
            <Panel Width="15" Height="15" VerticalAlignment="Center">
              <Ellipse Width="13" Height="13" Margin="0,0,2,2" StrokeThickness="1.6"
                       Stroke="{Binding $parent[Button].Foreground}"/>
              <Line StartPoint="10,10" EndPoint="14,14" StrokeThickness="1.6"
                    Stroke="{Binding $parent[Button].Foreground}"/>
            </Panel>
          </Button>
          <Button x:Name="BtnTbLook" Classes="tb-ico" ToolTip.Tip="外观">
            <Panel Width="15" Height="15" VerticalAlignment="Center">
              <Ellipse Width="13" Height="13" StrokeThickness="1.6"
                       Stroke="{Binding $parent[Button].Foreground}"/>
              <Path Data="M 7.5 2.4 A 5.2 5.2 0 1 0 12 12 Z" Fill="{Binding $parent[Button].Foreground}"/>
            </Panel>
          </Button>
          <Button x:Name="BtnTbLang" Classes="tb-ico" ToolTip.Tip="语言 / Language">
            <Panel Width="15" Height="15" VerticalAlignment="Center">
              <Path Data="M 2 4.5 L 8 4.5 M 5 2.5 L 5 4.5 M 3.4 4.5 C 3.4 7 5.6 8.6 7.4 9.2 M 2.4 6.5 C 3 8 4.6 9.6 7 10 M 9.5 13.5 L 12 8 L 14.5 13.5 M 10.3 11.8 L 13.7 11.8"
                    StrokeThickness="1.4" StrokeLineCap="Round"
                    Stroke="{Binding $parent[Button].Foreground}"/>
            </Panel>
          </Button>
        </StackPanel>
        <Panel Grid.Column="6">
          <StackPanel Orientation="Horizontal">
            <!-- Win11 原生窗钮字形：Segoe Fluent Icons（回退 Segoe MDL2 Assets） -->
            <Button Classes="wbtn" Click="OnMinimize" ToolTip.Tip="最小化">
              <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
            </Button>
            <Button Classes="wbtn" Click="OnMaximize" ToolTip.Tip="最大化">
              <TextBlock Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
            </Button>
            <Button Classes="wbtn close" Click="OnClose" ToolTip.Tip="关闭">
              <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
            </Button>
          </StackPanel>
        </Panel>
      </Grid>
    </Border>

    <!-- ============ 应用主体（导航 + 主区） ============ -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <!-- 左侧导航卡片（五项同列 + 折叠钮卡内右下） -->
      <Border x:Name="NavRail" Background="{DynamicResource VoxSurface}"
              BorderBrush="{DynamicResource VoxLine}" BorderThickness="1"
              CornerRadius="{DynamicResource VoxRadius}" BoxShadow="0 1 3 #0A000000"
              Margin="10,10,0,10" ClipToBounds="False" Width="56">
        <Panel>
          <ScrollViewer VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0">
            <StackPanel x:Name="NavItems" Margin="6,0" Spacing="2"/>
          </ScrollViewer>
          <Button x:Name="BtnNav" Classes="edge-btn"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Click="OnToggleNav"
                  ToolTip.Tip="收起 / 展开边栏">
            <Viewbox Width="12" Height="12">
              <icons:LucideIcon x:Name="BtnNavIcon" Kind="ChevronRight" Width="24" Height="24" StrokeThickness="2"/>
            </Viewbox>
          </Button>
        </Panel>
      </Border>

      <!-- 主区：页面宿主 + 弹层遮罩 + toast -->
      <Panel Grid.Column="1">
        <ContentControl x:Name="PageHost"/>
        <!-- 全局搜索浮层（原型 #searchOv/.search-panel：深色遮罩 + 600px 圆角 14 面板） -->
        <Border x:Name="SearchOverlay" Background="#59000000" IsVisible="False" ZIndex="60">
          <Border Width="600" VerticalAlignment="Top" Margin="0,64,0,0"
                  Background="{DynamicResource VoxSurface}" BorderBrush="{DynamicResource VoxLine}"
                  BorderThickness="1" CornerRadius="14" ClipToBounds="True"
                  BoxShadow="0 24 70 0 #29000000, 0 4 16 0 #14000000">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
              <!-- .sp-input：⌕ 图标 + 无边框输入 + Esc 键帽，底部分隔线 -->
              <Border Grid.Row="0" BorderBrush="{DynamicResource VoxLine}" BorderThickness="0,0,0,1"
                      Padding="16,13" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <icons:LucideIcon Kind="Search" Width="16" Height="16" StrokeThickness="2"
                                    VerticalAlignment="Center" Foreground="{DynamicResource VoxFaint}"/>
                  <Panel VerticalAlignment="Center">
                    <TextBox x:Name="SearchInput" Classes="sp-input" MinWidth="420"
                             Foreground="{DynamicResource VoxFg}"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="搜索文章、图片、操作…" FontSize="14" FontWeight="Medium"
                               Foreground="{DynamicResource VoxFaint}" IsHitTestVisible="False"
                               VerticalAlignment="Center" IsVisible="True"/>
                  </Panel>
                  <Button x:Name="SearchClose" Classes="kbd" Content="Esc" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <!-- .sp-tabs：pill 按钮（激活 accent-soft 底 accent 字） -->
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="12,9,12,0" x:Name="SearchTabs"/>
              <!-- .sp-list -->
              <ScrollViewer Grid.Row="2" Margin="8,6,8,10" MinHeight="120" MaxHeight="320" x:Name="SearchList"/>
              <!-- .sp-foot：surface-2 底 + 顶部分隔线 -->
              <Border Grid.Row="3" Background="{DynamicResource VoxSurface2}"
                      BorderBrush="{DynamicResource VoxLine}" BorderThickness="0,1,0,0" Padding="14,8">
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <TextBlock Text="↑↓ 导航" FontSize="10.5" Foreground="{DynamicResource VoxFaint}"/>
                  <TextBlock Text="Enter 打开" FontSize="10.5" Foreground="{DynamicResource VoxFaint}"/>
                  <TextBlock Text="Esc 关闭" FontSize="10.5" Foreground="{DynamicResource VoxFaint}"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Border>
                <!-- 弹层遮罩（.mask + .modal 宿主）：背景/ZIndex 显式声明（类样式对运行时可见性切换不可靠） -->
        <Border x:Name="ModalMask" Classes="mask" Background="{DynamicResource VoxMaskBg}" ZIndex="50"
                IsVisible="False" IsHitTestVisible="False">
          <ContentControl x:Name="ModalHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border x:Name="Toast" Classes="toast">
          <TextBlock x:Name="ToastText"/>
        </Border>
      </Panel>
    </Grid>
  </Grid>
</Window>
