<!-- ============================================================
     Vox 控件样式：design/assets/app.css + tokens.css 的 Avalonia 翻译。
     全部类作用域（不覆盖全局默认主题，避免与 AtomUI/Arc 控件主题打架）。
     Arc 已有组件必须直接使用 Arc 模板、Token 与交互；本文件只服务 Vox 自有语义类。
     颜色引用 VoxTheme.Apply 注入的 DynamicResource 画刷。
     ============================================================ -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ap="clr-namespace:Avalonia.Controls.Presenters;assembly=Avalonia.Controls"
        xmlns:md="using:CodeWF.Avalonia.Markdown.Controls"
        xmlns:conv="using:Avalonia.Data.Converters">

  <Styles.Resources>
    <FontFamily x:Key="VoxFontUi">Geist, Inter, $Default, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="VoxFontMono">Geist Mono, Cascadia Code, Consolas, monospace</FontFamily>
      <ControlTheme x:Key="VoxInputTheme" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource VoxLineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusControl}"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeMd}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource VoxAccentSoft}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource VoxAccent}"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    MinWidth="1" MinHeight="1">
              <Panel>
                <ap:TextPresenter Name="PART_TextPresenter"
                                  Text="{TemplateBinding Text}"
                                  TextWrapping="{TemplateBinding TextWrapping}"
                                  PasswordChar="{TemplateBinding PasswordChar}"
                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  CaretBrush="{TemplateBinding CaretBrush}"
                                  SelectionBrush="{TemplateBinding SelectionBrush}"
                                  SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                  Background="Transparent"
                                  VerticalAlignment="Center"/>
                <TextBlock Name="PART_Watermark"
                           Text="{TemplateBinding Watermark}"
                           Foreground="{DynamicResource VoxFaint}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           IsVisible="{TemplateBinding Text, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}"/>
              </Panel>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    
      <ControlTheme x:Key="VoxSwitchTheme" TargetType="ToggleButton">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="PART_Track" CornerRadius="99" Background="{DynamicResource VoxSurface3}"/>
              <Border Name="PART_Dot" Width="16" Height="16" CornerRadius="99" Margin="2,0,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Background="#FFFFFF" BoxShadow="0 1 3 #4D000000"/>
            </Panel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    
      <ControlTheme x:Key="VoxCheckTheme" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
        <!-- 原型 .article .task 口径：字号 0.9615rem（12.5px）、图标-文字 gap 8px -->
        <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeMd}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
              <Panel Width="15" Height="15" VerticalAlignment="Center">
                <Border Name="PART_Box" Width="14" Height="14" CornerRadius="4"
                        BorderThickness="1.5" BorderBrush="{DynamicResource VoxLineStrong}"
                        Background="Transparent"/>
                <TextBlock Name="PART_Mark" Text="✓" FontSize="{DynamicResource VoxFontSizeXxs}" Foreground="#FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="False"/>
              </Panel>
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </StackPanel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
  </Styles.Resources>

  <!-- ══════════ .btn（tokens.css 基类 + app.css 变体） ══════════ -->
  <Style Selector="Button.btn">
    <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLineStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusControl}"/>
    <!-- 原型 .btn：7px 14px 内距、字号 12.5px、圆角 8px（VoxRadiusControl=8，2026 refinement 口径） -->
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeMd}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLineStrong}"/>
  </Style>
  <Style Selector="Button.btn:pressed">
    <Setter Property="Opacity" Value="0.85"/>
  </Style>
  <Style Selector="Button.btn.primary">
    <Setter Property="Background" Value="{DynamicResource VoxAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxAccent}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxOnAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.btn.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxAccentDeep}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxAccentDeep}"/>
  </Style>
  <Style Selector="Button.btn.ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
  </Style>
  <Style Selector="Button.btn.ghost:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
  </Style>
  <Style Selector="Button.btn.danger">
    <Setter Property="Background" Value="{DynamicResource VoxDangerSoft}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxDanger}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.btn.sm">
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeSm}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusSmall}"/>
    <Setter Property="MinHeight" Value="24"/>
  </Style>

  <!-- ══════════ .input（TextBox 类主题：vinput） ══════════ -->
  <Style Selector="TextBox.vinput">
    <Setter Property="Theme" Value="{StaticResource VoxInputTheme}"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox.vinput:focus /template/ Border#PART_Border">
    <Setter Property="BorderBrush" Value="{DynamicResource VoxAccent}"/>
  </Style>
  <Style Selector="TextBox.vinput:disabled">
    <Setter Property="Opacity" Value="0.55"/>
  </Style>

  <!-- ══════════ .switch（34×20 圆点开关） ══════════ -->
  <Style Selector="ToggleButton.vswitch">
    <Setter Property="Theme" Value="{StaticResource VoxSwitchTheme}"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.22"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.vswitch:checked /template/ Border#PART_Dot">
    <Setter Property="Margin" Value="0,0,2,0"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
  </Style>
  <Style Selector="ToggleButton.vswitch:checked /template/ Border#PART_Track">
    <Setter Property="Background" Value="{DynamicResource VoxAccent}"/>
  </Style>

  <!-- ══════════ .badge（Border 容器 + 继承前景的文本） ══════════ -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource VoxSurface3}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusPill}"/>
    <Setter Property="Padding" Value="8,1"/>
    <Setter Property="TextElement.FontSize" Value="{DynamicResource VoxFontSizeXs}"/>
    <Setter Property="TextElement.FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="Border.badge.accent">
    <Setter Property="Background" Value="{DynamicResource VoxAccentSoft}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource VoxAccent}"/>
  </Style>
  <Style Selector="Border.badge.ok">
    <Setter Property="Background" Value="{DynamicResource VoxOkSoft}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource VoxOk}"/>
  </Style>
  <Style Selector="Border.badge.warn">
    <Setter Property="Background" Value="{DynamicResource VoxWarnSoft}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource VoxWarn}"/>
  </Style>
  <Style Selector="Border.badge.danger">
    <Setter Property="Background" Value="{DynamicResource VoxDangerSoft}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource VoxDanger}"/>
  </Style>

  <!-- ══════════ .chip ══════════ -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusPill}"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="TextElement.FontSize" Value="{DynamicResource VoxFontSizeSm}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource VoxMuted}"/>
  </Style>
  <Style Selector="Border.chip.add">
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLineStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <!-- .chip.sug（app.css 同名）：候选片，悬停强调色由代码挂 PointerEntered/Exited 处理 -->
  <Style Selector="Border.chip.sug">
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <!-- ══════════ .note.warn（YAML 解析失败黄条等警示条） ══════════ -->
  <Style Selector="Border.vwarn">
    <Setter Property="Background" Value="{DynamicResource VoxWarnSoft}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusControl}"/>
    <!-- 原型 .note 密度口径：9px 12px 内距、8px 圆角（VoxRadiusControl=8 同源） -->
    <Setter Property="Padding" Value="12,9"/>
  </Style>
  <Style Selector="Border.vwarn TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource VoxWarn}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeSm}"/>
  </Style>

  <!-- ══════════ .seg 分段控件容器与按钮（active 类由代码维护，同原型 JS） ══════════ -->
  <Style Selector="Border.seg">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <!-- 原型 .seg 容器圆角 9px（与 .btn/.input 的 8px 不同源，故钉值而非走 VoxRadiusControl） -->
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="2"/>
  </Style>
  <Style Selector="Border.seg Button.segbtn">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeSm}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Padding" Value="12,4"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusSmall}"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.seg Button.segbtn.active">
    <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
  </Style>

  <!-- ══════════ .navit 导航项（nav .it） ══════════ -->
  <Style Selector="Button.navit">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeMd}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusControl}"/>
    <!-- 原型 .nav .it（2026 refinement）：8px 11px 内距、min-height 38px、8px 圆角 -->
    <Setter Property="Padding" Value="11,8"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.navit:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
  </Style>
  <Style Selector="Button.navit.active">
    <Setter Property="Background" Value="{DynamicResource VoxAccentSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.navit Border.navcnt">
    <!-- 原型 .cnt 字号 0.7692rem（10px）→ Xxs 令牌，随密度档等比缩放 -->
    <Setter Property="TextElement.FontSize" Value="{DynamicResource VoxFontSizeXxs}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource VoxFaint}"/>
    <Setter Property="Background" Value="{DynamicResource VoxSurface3}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusPill}"/>
    <Setter Property="Padding" Value="7,0"/>
    <Setter Property="Height" Value="17"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.navit.active Border.navcnt">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource VoxAccent}"/>
  </Style>

  <!-- ══════════ 标题栏按钮（wbtn / tb-ico / tb-txt / edge-btn） ══════════ -->
  <Style Selector="Button.wbtn">
    <Setter Property="Width" Value="42"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.wbtn:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
  </Style>
  <Style Selector="Button.wbtn.close:pointerover">
    <Setter Property="Background" Value="#E81123"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
  <Style Selector="Button.tb-ico">
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <!-- 原型 .tb-ico 圆角 8px（30×30 方钮），非 VoxRadiusSmall 的 7px 档 -->
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.tb-ico:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxSurface3}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
  </Style>
  <!-- 标题栏语言菜单沿用 Vex 的布局，颜色接入 Vox 当前主题。 -->
  <Style Selector="FlyoutPresenter.title-language-picker">
    <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="LayoutRoot" Margin="32,20,32,44" VerticalAlignment="Top"
                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="0 12 32 0 #1E000000, 0 2 8 0 #0F000000" UseLayoutRounding="False" ClipToBounds="False">
          <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
            <ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.title-language-item">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Height" Value="{DynamicResource VoxLanguageRowHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource VoxLanguagePadding}"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.title-language-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
  </Style>
  <Style Selector="Button.title-language-item.active, Button.title-language-item.active:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxAccentSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxAccent}"/>
  </Style>
  <Style Selector="Button.title-language-item Border.language-chip">
    <Setter Property="Background" Value="{DynamicResource VoxAccentSoft}"/>
  </Style>
  <Style Selector="Button.title-language-item TextBlock.language-chip-text">
    <Setter Property="Foreground" Value="{DynamicResource VoxAccent}"/>
  </Style>
  <Style Selector="Button.title-language-item.active Border.language-chip">
    <Setter Property="Background" Value="{DynamicResource VoxAccent}"/>
  </Style>
  <Style Selector="Button.title-language-item.active TextBlock.language-chip-text">
    <Setter Property="Foreground" Value="{DynamicResource VoxOnAccent}"/>
  </Style>
  <Style Selector="Button.title-language-item TextBlock.language-check">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Button.title-language-item.active TextBlock.language-check">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="Button.tb-txt">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeMm}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusSmall}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.tb-txt:pointerover /template/ ContentPresenter">
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource VoxFg}"/>
  </Style>
  <Style Selector="Button.tb-txt:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxSurface3}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
  </Style>
  <Style Selector="Button.edge-btn">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusPill}"/>
    <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLineStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ZIndex" Value="20"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.edge-btn:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource VoxAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxAccent}"/>
  </Style>

  <!-- ══════════ 软件更新：标题栏药丸 + 日志气泡（原型 upd-pill/upd-pop/chg-*） ══════════ -->
  <!-- 评审修订（原型 D2）：药丸幽灵化——accent 12% 软底 + 32% 描边 + accent 文字 + 前置圆点；
       下载中切回实底 accent（进度渐变与 on-accent 读数不受影响）。 -->
  <Style Selector="Border.upd-pill">
    <Setter Property="Height" Value="22"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Background" Value="{DynamicResource VoxAccentGhost}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxAccentGhostBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.upd-pill:pointerover:not(.downloading)">
    <Setter Property="Background" Value="{DynamicResource VoxAccentGhostHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxAccent}"/>
  </Style>
  <Style Selector="Border.upd-pill.downloading">
    <Setter Property="Background" Value="{DynamicResource VoxAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxAccent}"/>
  </Style>
  <Style Selector="Ellipse.upd-pill-dot">
    <Setter Property="Width" Value="6"/>
    <Setter Property="Height" Value="6"/>
    <Setter Property="Fill" Value="{DynamicResource VoxAccent}"/>
  </Style>
  <Style Selector="Border.upd-pill.downloading Ellipse.upd-pill-dot">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <!-- 下载进度左段：accent-deep 掺 30% accent 提亮的混色（VoxAccentProgress 令牌随主题重算）。 -->
  <Style Selector="Border.upd-pill-fill">
    <Setter Property="CornerRadius" Value="11,0,0,11"/>
    <Setter Property="Background" Value="{DynamicResource VoxAccentProgress}"/>
  </Style>
  <Style Selector="TextBlock.upd-pill-text">
    <!-- 幽灵态用 accent 文字；下载中切 on-accent（实底上） -->
    <Setter Property="Foreground" Value="{DynamicResource VoxAccent}"/>
    <!-- 原型 .upd-pill 字号 0.7692rem（10px）→ Xxs 令牌（原误挂 Xs 10.5） -->
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeXxs}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Border.upd-pill.downloading TextBlock.upd-pill-text">
    <Setter Property="Foreground" Value="{DynamicResource VoxOnAccent}"/>
  </Style>
  <!-- 就绪后脉冲环：accent-soft 淡环呼吸三次，提示「重启以更新」。 -->
  <Style Selector="Border.upd-pill-pulse">
    <Setter Property="Margin" Value="-4"/>
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="BorderThickness" Value="5"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxAccentSoft}"/>
    <Setter Property="CornerRadius" Value="15"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <Style Selector="Border.upd-pill-pulse.ready">
    <Style.Animations>
      <Animation Duration="0:0:1.5" IterationCount="3">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0"/>
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="1"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0"/>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- 日志气泡：344px，标题/滚动正文/脚部三段（原型 .upd-pop 内距 16px 口径）。 -->
  <Style Selector="Border.upd-pop">
    <Setter Property="Width" Value="344"/>
    <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="BoxShadow" Value="0 12 32 0 #1E000000, 0 2 8 0 #0F000000"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.upd-pop-body">
    <Setter Property="Padding" Value="16,2,16,10"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>
  <Style Selector="Border.upd-pop-foot">
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="CornerRadius" Value="0,0,11,11"/>
  </Style>
  <Style Selector="Button.up-loglink">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeXs}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.up-loglink:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- 更新日志条目（气泡与更新窗共用，原型 .chg-*）：[系统要求]/[注意] 引用块 + 类型化分组。
       四档语义色：新增 ok / 优化 accent / 修复 warn / 删除 danger。 -->
  <Style Selector="Border.chg-quote">
    <Setter Property="Background" Value="{DynamicResource VoxSurface3}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxFaint}"/>
    <Setter Property="BorderThickness" Value="3,0,0,0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="11,8"/>
    <Setter Property="Margin" Value="0,8,0,2"/>
  </Style>
  <Style Selector="TextBlock.chg-quote">
    <Setter Property="FontStyle" Value="Italic"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeXs}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="StackPanel.chg-sec">
    <Setter Property="Margin" Value="0,10,0,0"/>
  </Style>
  <Style Selector="StackPanel.chg-sec > Border.chg-dot">
    <Setter Property="Width" Value="6"/>
    <Setter Property="Height" Value="6"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource VoxFaint}"/>
  </Style>
  <Style Selector="StackPanel.chg-sec > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeXs}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="0.4"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
  </Style>
  <Style Selector="StackPanel.chg-sec.t-new > Border.chg-dot">
    <Setter Property="Background" Value="{DynamicResource VoxOk}"/>
  </Style>
  <Style Selector="StackPanel.chg-sec.t-new > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource VoxOk}"/>
  </Style>
  <Style Selector="StackPanel.chg-sec.t-opt > Border.chg-dot">
    <Setter Property="Background" Value="{DynamicResource VoxAccent}"/>
  </Style>
  <Style Selector="StackPanel.chg-sec.t-opt > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource VoxAccent}"/>
  </Style>
  <Style Selector="StackPanel.chg-sec.t-fix > Border.chg-dot">
    <Setter Property="Background" Value="{DynamicResource VoxWarn}"/>
  </Style>
  <Style Selector="StackPanel.chg-sec.t-fix > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource VoxWarn}"/>
  </Style>
  <Style Selector="StackPanel.chg-sec.t-rm > Border.chg-dot">
    <Setter Property="Background" Value="{DynamicResource VoxDanger}"/>
  </Style>
  <Style Selector="StackPanel.chg-sec.t-rm > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource VoxDanger}"/>
  </Style>
  <Style Selector="TextBlock.chg-mark">
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeSm}"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
  <Style Selector="TextBlock.chg-item">
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeSm}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- 更新浮窗窗体（原型 uw-*）：自绘标题栏 + 进度轨道 + 日志卡。 -->
  <Style Selector="Border.uw-bar">
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="14,0,8,0"/>
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="TextBlock.uw-title">
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeXs}"/>
  </Style>
  <Style Selector="Button.uw-btn">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.uw-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxSurface3}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
  </Style>
  <Style Selector="Button.uw-btn.close:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxDangerSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxDanger}"/>
  </Style>
  <Style Selector="Border.uw-body">
    <Setter Property="Padding" Value="20,18,20,14"/>
  </Style>
  <Style Selector="Border.uw-logo">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="46"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="7"/>
  </Style>
  <Style Selector="Border.uw-progress">
    <Setter Property="Margin" Value="0,16,0,0"/>
  </Style>
  <Style Selector="Border.uw-track">
    <Setter Property="Height" Value="7"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusPill}"/>
    <Setter Property="Background" Value="{DynamicResource VoxSurface3}"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="Margin" Value="0,8,0,0"/>
  </Style>
  <Style Selector="Border.uw-fill">
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusPill}"/>
    <Setter Property="Background" Value="{DynamicResource VoxAccent}"/>
  </Style>
  <Style Selector="Border.uw-changes">
    <Setter Property="Margin" Value="0,14,0,0"/>
    <Setter Property="Padding" Value="14,4,14,10"/>
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>

  <!-- ══════════ .mnu 下拉菜单 ══════════ -->
  <Style Selector="Border.mnu">
    <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <!-- 原型 .mnu 圆角 10px（弹层族：mnu 10 / tb-pop 12 / modal 16 各自钉值） -->
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="5"/>
    <Setter Property="BoxShadow" Value="0 12 32 0 #1E000000, 0 2 8 0 #0F000000"/>
    <Setter Property="MinWidth" Value="150"/>
  </Style>
  <Style Selector="Border.mnu Button.mnuitem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeMm}"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusSmall}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.mnu Button.mnuitem:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxAccent}"/>
  </Style>

  <!-- ══════════ 弹层 .mask / .modal ══════════ -->
  <Style Selector="Border.mask">
    <Setter Property="Background" Value="{DynamicResource VoxMaskBg}"/>
    <Setter Property="ZIndex" Value="50"/>
  </Style>
  <Style Selector="Border.modal">
    <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <!-- 原型 .modal 圆角固定 16px（不随密度档 den-radius 缩放），故钉值不走 VoxRadius -->
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="BoxShadow" Value="0 24 70 0 #29000000, 0 4 16 0 #14000000"/>
    <Setter Property="Width" Value="560"/>
    <Setter Property="MaxHeight" Value="700"/>
  </Style>

  <!-- ══════════ toast 通知栈（评审修订：右下主题化卡片，多条排队、可关闭、淡入淡出） ══════════ -->
  <Style Selector="ItemsControl#ToastHost">
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Margin" Value="0,0,16,64"/>
  </Style>
  <Style Selector="Border.toast-item">
    <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14,9,10,9"/>
    <Setter Property="MaxWidth" Value="420"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource VoxFg}"/>
    <Setter Property="TextElement.FontSize" Value="{DynamicResource VoxFontSizeMm}"/>
    <Setter Property="TextElement.FontWeight" Value="Medium"/>
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.toast-close">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Opacity" Value="0.6"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.toast-close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="Button.toast-close:pointerover">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- ══════════ 平台状态点 .pm-st ══════════ -->
  <Style Selector="TextBlock.pm-st">
    <Setter Property="Width" Value="22"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="TextBlock.pm-st.ok"><Setter Property="Foreground" Value="{DynamicResource VoxOk}"/></Style>
  <Style Selector="TextBlock.pm-st.stale"><Setter Property="Foreground" Value="{DynamicResource VoxWarn}"/></Style>
  <Style Selector="TextBlock.pm-st.off"><Setter Property="Foreground" Value="{DynamicResource VoxFaint}"/></Style>
  <Style Selector="TextBlock.pm-st.err"><Setter Property="Foreground" Value="{DynamicResource VoxDanger}"/></Style>

  <!-- ══════════ 通用卡片 / 统计 ══════════ -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadius}"/>
  </Style>
  <Style Selector="TextBlock.flabel">
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeXs}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="Margin" Value="0,13,0,5"/>
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource VoxFontMono}"/>
  </Style>

  <!-- ══════════ 复选框（vcheck：14×14 圆角小方框） ══════════ -->
  <Style Selector="CheckBox.vcheck">
    <Setter Property="Theme" Value="{StaticResource VoxCheckTheme}"/>
  </Style>
  <Style Selector="CheckBox.vcheck:checked /template/ Border#PART_Box">
    <Setter Property="Background" Value="{DynamicResource VoxAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxAccent}"/>
  </Style>
  <Style Selector="CheckBox.vcheck:checked /template/ TextBlock#PART_Mark">
    <Setter Property="IsVisible" Value="True"/>
  </Style>


  <!-- ══════════ 写作页（app.css .wit/.viewseg/.wtabs/.outl/.drop/.thumb） ══════════ -->
  <Style Selector="Button.wit">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <!-- 原型 app.css .wit 密度口径：4px 10px 内距、6px 圆角行、1px 行距 -->
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Margin" Value="0,0,0,1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.wit:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
  </Style>
  <Style Selector="Button.wit.active">
    <Setter Property="Background" Value="{DynamicResource VoxAccentSoft}"/>
  </Style>

  <!-- 参照 Vex files-list：紧凑单行、6px 圆角、1px 行距；树形只展平可见层级，两种模式均虚拟化。 -->
  <Style Selector="ListBox.files-list">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="6,0,16,0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <!-- Arc 没有基础 ListBox 模板；沿用 Avalonia 标准宿主保留虚拟化与键盘选择。 -->
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ScrollViewer Name="PART_ScrollViewer"
                        Background="{TemplateBinding Background}"
                        AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                        BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}"
                        HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                        VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                        IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                        IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}">
            <ItemsPresenter Name="PART_ItemsPresenter" Margin="{TemplateBinding Padding}"
                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.files-list ListBoxItem">
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="Margin" Value="0,0,0,1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.files-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
  </Style>
  <Style Selector="ListBox.files-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.files-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VoxAccentSoft}"/>
  </Style>
  <Style Selector="ListBox.files-list Border.article-selection-marker">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="ListBox.files-list ListBoxItem:selected Border.article-selection-marker">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="ListBox.files-list ListBoxItem:selected TextBlock.article-navigation-title, Grid.article-navigation-row.group TextBlock.article-navigation-title">
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="Border.viewseg">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <!-- 原型 .viewseg：容器 8px 圆角、按钮 6px、26×22（.lhead 视图切换） -->
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="2"/>
  </Style>
  <Style Selector="Border.viewseg Button.vsegbtn">
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFaint}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Border.viewseg Button.vsegbtn.active">
    <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxAccent}"/>
  </Style>

  <Style Selector="Button.wtabbtn">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeSm}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="0,9"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0,0,0,2"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.wtabbtn.active">
    <Setter Property="Foreground" Value="{DynamicResource VoxAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxAccent}"/>
  </Style>

  <Style Selector="Border.drop">
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLineStrong}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <!-- 原型 .drop：11px 圆角（1.5px 虚线框）、18px 12px 内距、字号 0.8846rem -->
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="12,18"/>
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="TextElement.FontSize" Value="{DynamicResource VoxFontSizeSm}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Border.drop:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource VoxAccent}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource VoxAccent}"/>
    <Setter Property="Background" Value="{DynamicResource VoxAccentSoft}"/>
  </Style>

  <Style Selector="Border.thumb">
    <Setter Property="Height" Value="58"/>
    <!-- 原型 .thumb：58px 高、8px 圆角 -->
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Border.thumb TextBlock.tlabel">
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeTiny}"/>
    <Setter Property="FontFamily" Value="{DynamicResource VoxFontMono}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="Background" Value="#73000000"/>
    <Setter Property="Padding" Value="5,2"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="TextAlignment" Value="Left"/>
  </Style>

  <!-- ══════════ 全局搜索浮层（app.css .sp-input/.sp-tabs/.sp-it/.kbd） ══════════ -->
  <Style Selector="TextBox.sp-input">
    <Setter Property="Theme" Value="{StaticResource VoxInputTheme}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeXl}"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="Button.kbd">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusTiny}"/>
    <Setter Property="Padding" Value="6,1"/>
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="FontFamily" Value="{DynamicResource VoxFontMono}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeXxs}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFaint}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.kbd:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
  </Style>
  <Style Selector="Button.sptab">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeSm}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Padding" Value="11,4"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusSmall}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.sptab:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
  </Style>
  <Style Selector="Button.sptab.active">
    <Setter Property="Background" Value="{DynamicResource VoxAccentSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxAccent}"/>
  </Style>
  <Style Selector="Button.sp-it">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeMd}"/>
    <Setter Property="Padding" Value="10,8"/>
    <!-- 原型 .sp-it：8px 10px 内距、8px 圆角 -->
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.sp-it:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxAccentSoft}"/>
  </Style>
  <Style Selector="Button.sp-it.active">
    <Setter Property="Background" Value="{DynamicResource VoxAccentSoft}"/>
  </Style>

  <!-- ToolTip：Arc 未提供 ToolTip 主题，覆盖 Avalonia 默认（白盒紧贴）为 Vox 卡片风格 -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
    <Setter Property="FontFamily" Value="{DynamicResource VoxFontUi}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeSm}"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="MaxWidth" Value="360"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource VoxLineStrong}"
                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"
                BoxShadow="0 4 14 0 #22000000">
          <ContentPresenter Content="{TemplateBinding Content}" Margin="0"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToolTip TextBlock">
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="18"/>
  </Style>

  <!-- ══════════ 数据表格：CodeWF Semi 主题之上套原型 .tbl 口径 ══════════ -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="FontFamily" Value="{DynamicResource VoxFontUi}"/>
    <Setter Property="RowBackground" Value="Transparent"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource VoxLine}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFaint}"/>
    <Setter Property="FontSize" Value="{DynamicResource VoxFontSizeXs}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="MinHeight" Value="34"/>
  </Style>
  <!-- Semi 主题的悬停/按下底色与 Vox 画刷不一致，这里压平 -->
  <Style Selector="DataGridColumnHeader:pointerover /template/ Border#HeaderBackground">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="DataGridColumnHeader:pressed /template/ Border#HeaderBackground">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="DataGridRow /template/ Border#BackgroundBorder">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Border#BackgroundBorder">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
  </Style>
  <Style Selector="DataGridRow:selected /template/ Border#BackgroundBorder">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
  </Style>
  <Style Selector="DataGridRow:selected:pointerover /template/ Border#BackgroundBorder">
    <Setter Property="Background" Value="{DynamicResource VoxSurface2}"/>
  </Style>
  <Style Selector="DataGridRow /template/ Rectangle#PART_BottomGridLine">
    <Setter Property="Fill" Value="{DynamicResource VoxLine}"/>
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <!-- 查找浮条（Typora 口径：右上角紧凑小条，输入框 180 定宽 + 计数 + 选项 + 上下/关闭）。 -->
  <Style Selector="Border.find-float">
    <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLineStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource VoxRadiusControl}"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="BoxShadow" Value="0 6 16 0 #22000000"/>
  </Style>
  <Style Selector="Border.find-float TextBox">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource VoxFg}"/>
  </Style>
  <Style Selector="Border.find-float ToggleButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.find-float ToggleButton:checked">
    <Setter Property="Background" Value="{DynamicResource VoxAccentSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxAccent}"/>
  </Style>
  <Style Selector="Border.find-float Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.find-float Button:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource VoxFg}"/>
  </Style>

  <!-- 导图缩放坞（与 Vex / 原型同口径）：读数 + 步进 + 复位，令牌化配色。 -->
  <Style Selector="Border.map-dock">
    <Setter Property="Background" Value="{DynamicResource VoxSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VoxLineStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="4,4"/>
    <Setter Property="BoxShadow" Value="0 3 12 0 #14000000"/>
  </Style>
  <Style Selector="Border.map-dock Button.dock-btn">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxMuted}"/>
  </Style>
  <Style Selector="Border.map-dock Button.dock-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource VoxAccentSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource VoxAccent}"/>
  </Style>
</Styles>
