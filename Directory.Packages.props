<Project>
  <Import Project="build/Versions.props" />

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="$(AvaloniaEditVersion)" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.4.0" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="$(AvaloniaEditTextMateVersion)" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="$(TextMateSharpGrammarsVersion)" />
    <PackageVersion Include="TKCode.Arc" Version="$(ArcVersion)" />
    <PackageVersion Include="TKCode.Arc.Fonts" Version="$(ArcVersion)" />
    <PackageVersion Include="TKCode.Arc.Icons.Lucide" Version="$(ArcVersion)" />
    <PackageVersion Include="CodeWF.Toolkit.Lang" Version="$(CodeWFToolkitVersion)" />
    <PackageVersion Include="CodeWF.Avalonia.Lang" Version="$(CodeWFAvaloniaVersion)" />
    <PackageVersion Include="CodeWF.Avalonia.DataGrid" Version="$(CodeWFAvaloniaVersion)" />
    <PackageVersion Include="CodeWF.Avalonia.Controls" Version="$(CodeWFAvaloniaVersion)" />
    <PackageVersion Include="CodeWF.Avalonia.Markdown" Version="$(CodeWFAvaloniaVersion)" />
    <PackageVersion Include="CodeWF.Avalonia.Markdown.Lite" Version="$(CodeWFAvaloniaVersion)" />
    <PackageVersion Include="CodeWF.Avalonia.MindView" Version="$(CodeWFAvaloniaVersion)" />
    <PackageVersion Include="CodeWF.Avalonia.Lang.Generator" Version="$(CodeWFAvaloniaVersion)" />
    <PackageVersion Include="YamlDotNet" Version="$(YamlDotNetVersion)" />
    <PackageVersion Include="LibGit2Sharp" Version="$(LibGit2SharpVersion)" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="$(CommunityToolkitMvvmVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(DotNetLibrariesVersion)" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="$(DotNetLibrariesVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNetTestSdkVersion)" />
    <PackageVersion Include="xunit" Version="$(XunitVersion)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualStudioVersion)" />
  </ItemGroup>
</Project>
