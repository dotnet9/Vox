<Project>
  <PropertyGroup>
    <AvaloniaVersion>12.1.6</AvaloniaVersion>
    <AvaloniaEditVersion>12.0.0</AvaloniaEditVersion>
    <AvaloniaEditTextMateVersion>12.0.0</AvaloniaEditTextMateVersion>
    <TextMateSharpGrammarsVersion>3.0.0-preview.1</TextMateSharpGrammarsVersion>
    <!-- Arc 仍精确依赖 Avalonia 12.1.4；保留 NU1608，并用本机/CI 原生验证覆盖 12.1.5。 -->
    <ArcVersion>1.0.0</ArcVersion>
    <!-- StreamMark（自研流式 Markdown，AI 会话气泡）：与 Arc Blocks 同走 ADR 0011 口径，精确钉版 -->
    <StreamMarkVersion>0.1.2</StreamMarkVersion>
    <CodeWFToolkitVersion>1.1.6</CodeWFToolkitVersion>
    <CodeWFAvaloniaVersion>12.1.6.4</CodeWFAvaloniaVersion>
    <YamlDotNetVersion>18.1.0</YamlDotNetVersion>
    <LibGit2SharpVersion>0.32.0</LibGit2SharpVersion>
    <CommunityToolkitMvvmVersion>8.4.2</CommunityToolkitMvvmVersion>
    <DotNetLibrariesVersion>11.0.0</DotNetLibrariesVersion>
    <MicrosoftNetTestSdkVersion>18.12.0</MicrosoftNetTestSdkVersion>
    <XunitVersion>2.9.3</XunitVersion>
    <XunitRunnerVisualStudioVersion>4.0.1</XunitRunnerVisualStudioVersion>
  </PropertyGroup>
</Project>
